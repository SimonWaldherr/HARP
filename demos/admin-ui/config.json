{
  "compatibilityMode": "",
  "grpcPort": ":50054",
  "httpPort": ":8080",
  "http3Port": ":8445",
  "enableGRPCTLS": false,
  "grpcTLSCert": "",
  "grpcTLSKey": "",
  "enableHTTPS": false,
  "httpsCert": "",
  "httpsKey": "",
  "enableHTTP3": false,
  "enableCache": true,
  "cacheType": "memory",
  "diskCacheDir": "./cache",
  "cacheTTL": "30m",
  "allowedRegistration": [
    { "route": "/.*$", "key": "master-key" },
    { "route": "/test$", "key": "master-key", "username": "demo", "password": "route-demo" }
  ],
  "logLevel": "INFO",
  "loadBalancingStrategy": "round_robin",
  "maxConcurrentRequests": 1000,
  "maxConcurrentWebSockets": 256,
  "requestTimeout": "30s",
  "enableMetrics": true,
  "metricsPort": ":9091",
  "enableHealthCheck": true,
  "healthCheckPath": "/health",
  "connectionPoolSize": 100,
  "cacheMaxItems": 1000,
  "enableRateLimit": true,
  "rateLimitPerSecond": 100,
  "enableCompression": true,
  "maxHeaderSize": 8192,
  "readTimeout": "30s",
  "writeTimeout": "30s",
  "idleTimeout": "120s",
  "maxRequestBodySize": 10485760,
  "enableCORS": false,
  "corsAllowedOrigins": "*",
  "gracefulShutdownDelay": "10s",
  "enableAdminUI": true,
  "adminPath": "/admin",
  "adminUsername": "admin",
  "adminPassword": "admin-demo",
  "adminInsecureSkipAuth": false,
  "adminAllowedCIDRs": ["127.0.0.1/32", "::1/128"]
}
