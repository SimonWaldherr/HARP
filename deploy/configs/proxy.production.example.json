{
  "grpcPort": ":50054",
  "httpPort": ":8080",
  "http3Port": ":8445",
  "enableGRPCTLS": false,
  "grpcTLSCert": "",
  "grpcTLSKey": "",
  "enableHTTPS": false,
  "httpsCert": "",
  "httpsKey": "",
  "enableHTTP3": false,
  "enableCache": true,
  "cacheType": "memory",
  "diskCacheDir": "/var/lib/harp/cache",
  "cacheTTL": "10m",
  "allowedRegistration": [
    { "route": "/api/.*$", "key": "replace-with-long-random-route-key" }
  ],
  "logLevel": "INFO",
  "loadBalancingStrategy": "round_robin",
  "maxConcurrentRequests": 1000,
  "requestTimeout": "30s",
  "enableMetrics": true,
  "metricsPort": "127.0.0.1:9091",
  "enableHealthCheck": true,
  "healthCheckPath": "/health",
  "connectionPoolSize": 100,
  "enableRateLimit": true,
  "rateLimitPerSecond": 100,
  "enableCompression": true,
  "maxHeaderSize": 8192,
  "readTimeout": "30s",
  "writeTimeout": "30s",
  "idleTimeout": "120s",
  "maxRequestBodySize": 10485760,
  "enableCORS": false,
  "corsAllowedOrigins": "https://example.com",
  "gracefulShutdownDelay": "10s",
  "enableAdminUI": true,
  "adminPath": "/admin",
  "adminUsername": "admin",
  "adminPassword": "replace-with-long-random-admin-password",
  "adminInsecureSkipAuth": false,
  "adminAllowedCIDRs": ["127.0.0.1/32", "::1/128"]
}
