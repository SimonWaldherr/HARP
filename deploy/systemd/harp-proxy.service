[Unit]
Description=HARP reverse tunnel proxy
Documentation=https://github.com/SimonWaldherr/HARP
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=harp
Group=harp
ExecStart=/usr/local/bin/harp-proxy -config /etc/harp/config.json
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/harp
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
